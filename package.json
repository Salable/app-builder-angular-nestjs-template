{
  "name": "@app-builder/generated-angular-nestjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "dev": "npm run build && NODE_ENV=development node --env-file-if-exists=.env dist/server/local-server.mjs",
    "build": "ng build && node --import tsx scripts/build-server.ts && node --import tsx scripts/build-vercel.ts",
    "build:vercel": "npm run build",
    "deploy:vercel": "node --import tsx scripts/deploy-vercel.ts",
    "check:deployment:built": "node --import tsx scripts/check-deployment.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run generate:check && npm run build:vercel && npm run check:deployment:built && npm run test && npm run test:integration && npm run test:browser",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts",
    "generate:check": "node --import tsx scripts/generate-openapi.ts --check",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && ngc --noEmit -p tsconfig.app.json",
    "test": "vitest run && ng test --watch=false",
    "test:coverage": "vitest run --coverage && ng test --watch=false --coverage",
    "test:integration": "node --import tsx scripts/run-with-test-database.ts node --import tsx --test tests/api.integration.test.ts",
    "test:browser": "node --import tsx scripts/run-with-test-database.ts playwright test",
    "migrate": "node --import tsx scripts/migrate.ts",
    "migrate:rollback": "node --import tsx scripts/migrate.ts --rollback"
  },
  "dependencies": {
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "12.0.2",
    "better-auth": "1.6.24",
    "express": "5.1.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.18.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "globals": "17.4.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
